# LES VARIABLES QUE LE SITE ATTEND — SANS AUCUNE VALEUR.
#
# ⛔ Ce fichier est suivi par git. Il ne contient QUE des noms. La moindre vraie
# valeur collée ici part sur GitHub et doit être révoquée, pas effacée : un
# secret poussé une fois reste dans l'historique.
#
# ⚠️ Les valeurs vivent dans .env.local (jamais commité) et, pour la
# production, dans les variables d'environnement Vercel — les deux doivent être
# renseignées, remplir l'une ne remplit pas l'autre.
# ⚠️ Une valeur contenant une espace ou un caractère spécial se met entre
# guillemets, sinon elle est tronquée sans avertissement.

# ── IA ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Accès protégés ─────────────────────────────────────────────────────────
ADMIN_PASSWORD=
PILOTE_PASSWORD=

# ── Supabase ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ = lisible dans le navigateur, par conception. La clé de service,
# elle, ne doit JAMAIS porter ce préfixe : elle contourne toutes les règles RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Courrier sortant ───────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# ── Site ───────────────────────────────────────────────────────────────────
SITE_URL=

# ── Stripe (branchement prévu) ─────────────────────────────────────────────
# Le MODE se lit au préfixe de la clé secrète, il n'y a pas de variable
# « mode » : sk_test_… ne déplace pas un centime, sk_live_… si.
# ⛔ Commencer en sk_test_ et n'en sortir qu'une fois le parcours éprouvé de
# bout en bout. Le code refuse de lui-même l'encaissement réel tant que les CGV
# ne sont pas en vigueur (voir lib/paiement/stripe.ts).
STRIPE_SECRET_KEY=
# Fourni par Stripe au moment où l'on crée le point de terminaison de webhook.
# Sans lui, n'importe qui peut appeler la route et prétendre qu'un paiement a
# réussi : c'est ce secret qui prouve que le message vient bien de Stripe.
STRIPE_WEBHOOK_SECRET=
# Publique par nature (elle part dans le navigateur) : ce n'est pas un secret.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
